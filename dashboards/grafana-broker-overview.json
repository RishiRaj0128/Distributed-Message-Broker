  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Cluster Availability (SLA Target 99.999%)",
      "type": "stat",
      "targets": [
        {
          "expr": "100 - (sum(broker_under_replicated_partitions) / count(broker_active_nodes_count) * 0.01)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99.9 },
              { "color": "green", "value": 99.999 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Under-Replicated Partitions (CRITICAL)",
      "type": "stat",
      "targets": [
        {
          "expr": "broker_under_replicated_partitions",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Active Broker Nodes",
      "type": "stat",
      "targets": [
        {
          "expr": "broker_active_nodes_count",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Leader Elections (Failovers)",
      "type": "stat",
      "targets": [
        {
          "expr": "broker_leader_elections_total",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Throughput: Messages Ingested Rate (msg/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(broker_messages_in_total[1m])",
          "legendFormat": "Ingress Throughput",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Replication Quorum Latency (p95 / p99 ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(broker_replication_latency_ms_bucket[1m]))",
          "legendFormat": "p95 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(broker_replication_latency_ms_bucket[1m]))",
          "legendFormat": "p99 Latency",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "title": "Idempotent Producer: Duplicate Retries Suppressed",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(broker_producer_duplicates_suppressed_total[1m])",
          "legendFormat": "Suppressed Duplicates",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "title": "Backpressure & Flow Control Throttling Events",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(broker_backpressure_events_total[1m])",
          "legendFormat": "Backpressure Events",
          "refId": "A"
        }
      ]
    }
  ],
